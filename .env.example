# Vercel Postgres (Neon) を接続すると自動で設定される
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
ADMIN_PASSWORD=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Notion連携 (ブログ記事の同期)
# データベースには タイトル(Title) / 日付(Date, 作成日時でも可) / カテゴリ(Category) / タグ(Tags) / 画像(ImageUrl) を用意する
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Webhookによる自動同期を使う場合のみ設定 (/api/notion-webhook)
# NotionのIntegration設定でWebhookを作成した際に発行されるverification_tokenを設定する
NOTION_WEBHOOK_SECRET=
