generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Post {
  id       String   @id @default(uuid())
  title    String
  excerpt  String?
  content  String
  author   String?
  date     DateTime
  readTime String?
  category String
  tags     String?
  imageUrl String?
  links    String?
}
