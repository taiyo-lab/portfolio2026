generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Post {
  id       String   @id @default(uuid())
  notionId String?  @unique
  title    String
  excerpt  String?
  content  String
  author   String?
  date     DateTime
  readTime String?
  category String
  tags     String?
  imageUrl String?
  links    String?
}
